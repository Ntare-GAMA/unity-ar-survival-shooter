# Unity generated
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# Autogenerated IDE / solution files
.vs/
.vscode/
.idea/
.gradle/
.consulo/
ExportedObj/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity crash / build reports
sysinfo.txt
crashlytics-build.properties
mono_crash.*

# Builds (upload APKs to Releases/Drive instead of committing them)
*.apk
*.aab
*.app
*.unitypackage
*.unitypackage.meta

# Plastic SCM (Unity Version Control) — using git instead
.plastic/
ignore.conf
/[Aa]ssets/Plugins/PlasticSCM*

# Addressables / StreamingAssets build output
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# OS junk
.DS_Store*
Thumbs.db
Desktop.ini
